# Skopiuj ten plik do ".env" i uzupelnij. Plik .env jest w .gitignore (nie trafi do GitHuba).
TCX_FQDN=pbx.twojafirma.ie
TCX_CLIENT_ID=twoj-client-id
TCX_CLIENT_SECRET=twoj-api-key
# Ustaw na 0 TYLKO jesli PBX ma certyfikat self-signed i nie masz jak dodac CA (niezalecane)
# TCX_VERIFY_TLS=1
# Sciezka do wlasnego CA bundle (lepsze niz wylaczanie weryfikacji)
# TCX_CA_BUNDLE=/sciezka/do/ca.pem
