# Copy this file to ".env" and fill it in. The .env file is in .gitignore (it will not be pushed to GitHub).
TCX_FQDN=pbx.yourcompany.ie
TCX_CLIENT_ID=your-client-id
TCX_CLIENT_SECRET=your-api-key
# Set to 0 ONLY if the PBX has a self-signed certificate and you cannot add the CA (not recommended)
# TCX_VERIFY_TLS=1
# Path to your own CA bundle (better than disabling verification)
# TCX_CA_BUNDLE=/path/to/ca.pem
